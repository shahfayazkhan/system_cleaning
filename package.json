{
  "name": "clean-cache",
  "version": "1.0.0",
  "private": true,
  "description": "Safe, cross-platform (macOS & Windows) cache cleaner built with Next.js. Removes only regenerable caches — never your documents, photos or apps.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 4321",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4321",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2"
  }
}
